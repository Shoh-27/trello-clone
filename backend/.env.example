APP_NAME="Trello Clone"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Database Configuration (PostgreSQL)
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=trello_db
DB_USERNAME=trello_user
DB_PASSWORD=trello_secret

# pgAdmin Access
# URL: http://localhost:5050
# Email: admin@trello.local
# Password: admin123
# PostgreSQL connection in pgAdmin:
#   Host: db
#   Port: 5432
#   Database: trello_db
#   Username: trello_user
#   Password: trello_secret

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Socket Server Configuration
SOCKET_SERVER_URL=http://socket:3000
SOCKET_EVENT_ENDPOINT=/events

# Sanctum Configuration
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,localhost:80
SESSION_DOMAIN=localhost

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:5173
